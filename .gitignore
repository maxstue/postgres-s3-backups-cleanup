# Go binaries and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Build output (including `go build ./cmd/backup` and `go build ./cmd/cleanup`)
/bin/
/dist/
/backup
/cleanup

# Test binaries, coverage reports and profiling output
*.test
*.out
*.prof
/coverage/
/coverage.html
/coverage.txt

# Local multi-module workspace; keep go.mod and go.sum versioned
go.work
go.work.sum

# Local environment files; keep sanitized templates versioned
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Editor temporary files and local IDE state
*.swp
*.swo
*~
.idea/
.vscode/*.local.json

# Operating system metadata
.DS_Store
._*
Thumbs.db
Desktop.ini

# Local scratch files
/tmp/
/temp/
