# Detect text files automatically and use LF on every platform.
* text=auto eol=lf

# Explicitly treat Go source, module metadata and shell scripts as text.
*.go text
go.mod text
go.sum text
go.work text
go.work.sum text
*.sh text eol=lf

# Windows command scripts require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Never normalize or produce text diffs for binary assets and archives.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.gz binary
*.zip binary
*.tar binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
